# Version-locked to VLLM_REF=v0.31.0rc3 (`git apply --check` clean).
# Qwen3 parser: a malformed <parameter> element no longer leaks into
# streamed arguments (vLLM issue #55495, fix PR #55497 — OPEN + CONFLICTING,
# in no release as of 2026-10-01; both upstream commits carried verbatim,
# source-only — upstream tests validated separately, see below).
# Upstream state: PR #55497 by ywatanabe1989 (reviewed + approved, 61/61
# parser tests green upstream). Touches the same engine-parser path as the
# carried 47137 patch but different lines — the two compose. Related open
# PRs, same function, alternate strategies (not carried): #53739 (terminate
# streamed args the flush cannot extend), #58407 (keep copied tool closers
# inside values — semantic tension with drop-malformed, monitor).
# What it does: (1) vllm/parser/qwen3.py — the parameter-name group
# ([^>]* / [^>]+) accepted whitespace/newlines/another tag, so a slightly
# off element (<parameter=\n..., <parameter=ids: [...] without >, or
# <parameter=note=) made the PARTIAL converter stream everything up to the
# closing tag's `>` as a key (e.g. "echo ...\n</parameter") while the FINAL
# conversion did not — prefix invariant broke, client kept an unterminated
# JSON arguments string and raw </parameter> leaked into content (the
# 2026-10-01 <tool_call> leak seen live on this stack). Both regexes now
# share _PARAM_NAME = ([^>\s<]+): malformed elements are dropped
# consistently, arguments stay valid JSON. (2) parser_engine.py —
# _flush_arg_converter logs a warning (tool name + lengths only, never
# argument content) instead of returning None in silence, so the next
# occurrence of this class is visible in container logs instead of silent.
# Verified 2026-10-01: cherry-picks cleanly onto v0.31.0rc3; upstream
# TestMalformedParameterElements run inside the running v0.31.0rc3 container
# FAILS 7/10 on stock code (positive control — bug present in our build)
# and the full tests/parser/engine/test_qwen3.py PASSES 61/61 with the
# regex half applied at runtime (no regressions in existing tests).
# Drop when a pinned VLLM_REF contains the #55497 merge (check merge commit
# vs tag — the PR is still OPEN + needs-rebase, so not in any rc/final yet).
# Leading comments are ignored by `git apply`.
diff --git a/vllm/parser/engine/parser_engine.py b/vllm/parser/engine/parser_engine.py
index 527c310c1..10a8ad13c 100644
--- a/vllm/parser/engine/parser_engine.py
+++ b/vllm/parser/engine/parser_engine.py
@@ -1067,6 +1067,19 @@ class ParserEngine(Parser):
         prev = slot.streamed_json
         if final_json and len(final_json) > len(prev):
             if prev and not final_json.startswith(prev):
+                # The streamed prefix cannot be retracted, so the client is
+                # left with whatever was already sent — which is not valid
+                # JSON when this happens. Say so instead of failing silently.
+                # Lengths only: the arguments are user data and may hold
+                # secrets, so they must not reach the log.
+                logger.warning(
+                    "arg converter: final arguments do not extend the "
+                    "streamed prefix; the client keeps a truncated string "
+                    "(tool=%s streamed=%d chars, final=%d chars)",
+                    slot.name,
+                    len(prev),
+                    len(final_json),
+                )
                 return None
             diff = final_json[len(prev) :]
             slot.streamed_json = final_json
diff --git a/vllm/parser/qwen3.py b/vllm/parser/qwen3.py
index a11551a20..83409f077 100644
--- a/vllm/parser/qwen3.py
+++ b/vllm/parser/qwen3.py
@@ -48,13 +48,26 @@ FUNC_END = "</function>"
 PARAM_START = "<parameter="
 PARAM_END = "</parameter>"
 
+# A parameter NAME never contains whitespace or another tag. Accepting
+# ``[^>]`` here let a malformed element such as ``<parameter=\necho $X\n</parameter>``
+# or ``<parameter=note=\n</parameter>`` turn everything up to the *next* ``>``
+# (the closing tag's) into a key; the partial converter then streamed that key
+# while the final conversion did not produce it, the prefix invariant broke, and
+# the client was left holding an unterminated JSON object
+# (vllm-project/vllm#55495). The name is also required to be non-empty, so
+# ``<parameter=>value</parameter>`` is dropped rather than emitted as ``{"": ...}``;
+# both regexes share the group so the partial and the final conversion agree.
+_PARAM_NAME = r"([^>\s<]+)"
 _PARAM_RE = re.compile(
-    r"<\s*parameter\s*=\s*([^>]*)>"
+    r"<\s*parameter\s*=\s*" + _PARAM_NAME + r">"
     r"(.*?)"
     r"(?:<\s*/\s*parameter\s*>|(?=<\s*parameter\s*=))",
     re.DOTALL,
 )
-_PARTIAL_PARAM_RE = re.compile(r"<\s*parameter\s*=\s*([^>]+)>(.*)$", re.DOTALL)
+_PARTIAL_PARAM_RE = re.compile(
+    r"<\s*parameter\s*=\s*" + _PARAM_NAME + r">(.*)$",
+    re.DOTALL,
+)
 
 
 def _trim_wrapping_newlines(value: str) -> str:
