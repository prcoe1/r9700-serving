+    def _is_w4a16_int4(
+        self,
+        weight_quant: dict[str, Any] | list[dict[str, Any]] | None,
+        input_quant: dict[str, Any] | list[dict[str, Any]] | None,
+    ) -> bool:
+        # W4A16 weight-only: activations stay unquantized (input config None).
+        if weight_quant is None or input_quant is not None:
+            return False
+
+        normalized = self._unwrap_single_quant_config(weight_quant)
+        if normalized is None:
+            return False
+
+        is_int4 = normalized.get("dtype") in ("int4", "uint4")
+        is_packed = self.pack_method in ("order", "reorder")
+        if not (is_int4 and is_packed):
+            return False
+
+        try:
+            parse_w4a16_int4_weight_config(normalized)
+        except ValueError:
+            return False
+        return True
+
+    @staticmethod
+    def _unwrap_single_quant_config(
+        quant_config: dict[str, Any] | list[dict[str, Any]],
+    ) -> dict[str, Any] | None:
+        """Unwrap one-entry quantization-config lists."""
+        if isinstance(quant_config, list):
+            return quant_config[0] if len(quant_config) == 1 else None
+        return quant_config
+
     def _is_w4a8_mxfp4_fp8(
         self,
         weight_quant: dict[str, Any] | None,
@@ -703,6 +746,24 @@ class QuarkConfig(QuantizationConfig):
