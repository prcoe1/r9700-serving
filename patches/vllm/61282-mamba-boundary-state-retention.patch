From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: opencode <opencode@localhost>
Date: Thu, 15 Oct 2026 00:00:00 +0000
Subject: [PATCH] [Bugfix] Keep the Mamba prompt-boundary state until request
 end and evict it after its attention blocks (upstream #61282)

Version-locked to VLLM_REF=v0.32.0rc2 (upstream #61282 applies verbatim, no
re-cut; production files only — the upstream test file is validated
separately, see below).
Upstream PR #61282 by ruobing-wang (fix for #61281; OPEN + unmerged, single
commit, no human review as of 2026-10-15). Drop when a pinned VLLM_REF
contains the merge. Re-check for author updates (rebase/conflicts) on any bump.
What it does (retention-only, no new checkpoint values):
- MambaManager._retain_boundary_block: one extra ref on the request's reusable
  prompt-boundary state (taken where the request comes to own it: cache_blocks
  full-block registration, _cache_partial_tail_block checkpoint/partial tail,
  add_local_computed_blocks adopted hit; the hold moves with the hash across
  CoW). Released in pop_blocks_for_free after the request's other blocks.
- Coordinator._free_order: attention groups freed before Mamba groups
  (direct free + deferred pop_blocks_for_free paths), so the single reusable
  state is the last of the request's blocks to reach the LRU queue.
Safety/correctness notes (verified 2026-10-15 on rc2+GDN geometry):
- No new checkpoint positions or hash keys are created (unlike #53479, which
  materializes new states) — resume adopts the identical content-bound hash,
  so no new #55766-NaN class is introduced. Cost: one extra block per Mamba
  group per running request.
- No leak on either free path: base SingleTypeKVCacheManager.free() funnels
  through pop_blocks_for_free, where the hold is released (upstream tests
  assert free-block counts + ref_cnt 0; re-verified in scratch).
- Composes with the carried #48375 (lookup-side eagle drop) and #50409
  (scheduler chunk stops): different functions/regions, full ordered apply
  clean. #48375's drop stays load-bearing for draft-polluted states.
Validation (scratch rc2 + all 10 carried patches, GDN MambaSpec/align,
block 832/16, MTP-style drop_eagle, scheduler-faithful chunking):
- Upstream tests/v1/core/test_mamba_boundary_snapshot_lifetime.py: 16/16 PASS
  (fails on unpatched code — positive control), run in a throwaway container.
- Own geometry matrix (benchmarks/mamba_boundary_lifetime_probe.py,
  GPU-free): baseline recycles the boundary under churn -> 0% (attn hits,
  mamba 0); with this patch -> full boundary reuse incl. 3-turn chains and
  4160-token long-prompt reuse; short prompts stay 0% everywhere (structural,
  no phantoms). Live server (unpressured) already shows real 1664/3328-token
  reuse with latency wins, so registration+reconcile are proven end to end;
  this patch closes the pressured-lifetime gap.
---
diff --git a/vllm/v1/core/kv_cache_coordinator.py b/vllm/v1/core/kv_cache_coordinator.py
index 7d4f2d5a2b44..ae97e282e268 100644
--- a/vllm/v1/core/kv_cache_coordinator.py
+++ b/vllm/v1/core/kv_cache_coordinator.py
@@ -175,6 +175,17 @@ def __init__(
             for manager in self.single_type_managers:
                 if isinstance(manager, MambaManager):
                     manager.drop_eagle_checkpoint_block = True
+        # Order in which a finished request's groups return their blocks to
+        # the pool. A Mamba group's reusable state is a single block, and
+        # evicting it voids the hybrid hit for every attention block of that
+        # prefix, so attention groups go first (evicted first) and Mamba
+        # groups last; single-group models are unaffected.
+        self._free_order = tuple(
+            sorted(
+                self.single_type_managers,
+                key=lambda manager: isinstance(manager, MambaManager),
+            )
+        )
         self.group_block_sizes = tuple(
             manager.block_size for manager in self.single_type_managers
         )
@@ -398,13 +409,14 @@ def reset_prefix_cache(self) -> bool:
         return all([pool.reset_prefix_cache() for pool in pools])
 
     def free(self, request_id: str) -> None:
-        """Free the blocks for the request.
+        """Free the blocks for the request, one group at a time in
+        ``_free_order``.
 
         Args:
             request_id: The request ID.
 
         """
-        for manager in self.single_type_managers:
+        for manager in self._free_order:
             manager.free(request_id)
 
     def pop_blocks_for_free(self, request_id: str) -> list[KVCacheBlock]:
@@ -418,11 +430,13 @@ def pop_blocks_for_free(self, request_id: str) -> list[KVCacheBlock]:
             request_id: The request ID.
 
         Returns:
-            The request's blocks in allocation order.
+            Each group's blocks in allocation order, groups in reverse
+            ``_free_order``, so that freeing the list in reverse releases
+            the groups in the same order as ``free``.
 
         """
         blocks: list[KVCacheBlock] = []
-        for manager in self.single_type_managers:
+        for manager in reversed(self._free_order):
             blocks.extend(manager.pop_blocks_for_free(request_id))
         return blocks
 
diff --git a/vllm/v1/core/single_type_kv_cache_manager.py b/vllm/v1/core/single_type_kv_cache_manager.py
index 2e4fe55b96c2..afdaecf65763 100644
--- a/vllm/v1/core/single_type_kv_cache_manager.py
+++ b/vllm/v1/core/single_type_kv_cache_manager.py
@@ -1449,6 +1449,10 @@ def __init__(
             # connector; a request that finishes first hands off this table
             # source directly.
             self._producer_partial_tail_reqs: dict[str, tuple[KVCacheBlock, int]] = {}
+            # The block holding each running request's reusable prompt-boundary
+            # state, referenced on the request's behalf until it is freed (see
+            # ``_retain_boundary_block``).
+            self._boundary_blocks: dict[str, KVCacheBlock] = {}
 
     @classmethod
     def find_longest_cache_hit(
@@ -1875,6 +1879,12 @@ def allocate_new_blocks(
                         self.block_pool.move_block_hashes(source_block, cow_block)
                         self._pending_cow_copies.append((source_block, cow_block))
                         source_block.ref_cnt += 1
+                        if self._boundary_blocks.get(request_id) is source_block:
+                            # The boundary state moves to cow_block with its
+                            # hash; move the request's hold on it as well.
+                            source_block.ref_cnt -= 1
+                            cow_block.ref_cnt += 1
+                            self._boundary_blocks[request_id] = cow_block
                         producer_tail = self._producer_partial_tail_reqs.pop(
                             request_id, None
                         )
@@ -1949,6 +1959,19 @@ def pop_blocks_for_free(self, request_id: str) -> list[KVCacheBlock]:
                 for entry in self._pending_boundary_state_offloads
                 if entry[0] != request_id
             ]
+            boundary_block = self._boundary_blocks.pop(request_id, None)
+            if boundary_block is not None:
+                blocks = super().pop_blocks_for_free(request_id)
+                if any(block is boundary_block for block in blocks):
+                    # Still in the table (its own entry frees it): just drop
+                    # the hold, it cannot be the last reference.
+                    boundary_block.ref_cnt -= 1
+                    return blocks
+                # Retired from the table, so the hold is the request's only
+                # reference. Callers free in reverse order: list it first so
+                # the single reusable state is the last of the request's
+                # blocks to reach the free queue.
+                return [boundary_block, *blocks]
         return super().pop_blocks_for_free(request_id)
 
     def get_num_skipped_tokens(self, num_computed_tokens: int) -> int:
@@ -1982,6 +2005,11 @@ def cache_blocks(
                 self.cached_blocks_this_step.add(partial_hash)
         if num_cached_blocks_after > num_cached_blocks_before:
             blocks = self.req_to_blocks[request.request_id]
+            prompt_boundary = (
+                self._prompt_boundary(request)
+                if self.mamba_cache_mode == "align"
+                else None
+            )
             for idx in range(num_cached_blocks_before, num_cached_blocks_after):
                 block = blocks[idx]
                 # Skip null blocks (align-mode skipped states) and blocks that
@@ -2004,10 +2032,75 @@ def cache_blocks(
                             block.block_hash_num_tokens,
                         )
                     )
+                    if block.block_hash_num_tokens == prompt_boundary:
+                        self._retain_boundary_block(request.request_id, block)
 
     def new_step_starts(self) -> None:
         self.cached_blocks_this_step.clear()
 
+    def add_local_computed_blocks(
+        self,
+        request_id: str,
+        new_computed_blocks: Sequence[KVCacheBlock],
+        num_local_computed_tokens: int,
+        num_external_computed_tokens: int,
+    ) -> None:
+        super().add_local_computed_blocks(
+            request_id,
+            new_computed_blocks,
+            num_local_computed_tokens,
+            num_external_computed_tokens,
+        )
+        if self.mamba_cache_mode != "align" or not new_computed_blocks:
+            return
+        # A resumed or sibling request takes over a cached state it never
+        # registers itself (a sub-block hit is even CoW-copied out of the
+        # table). Hold the hit state like an own registration; registering
+        # the request's own boundary later replaces the hold. External
+        # computed tokens can skip the whole local hit, in which case the
+        # hit block was neither adopted nor touched.
+        hit_block = new_computed_blocks[-1]
+        req_blocks = self.req_to_blocks[request_id]
+        if (
+            req_blocks
+            and req_blocks[-1] is hit_block
+            and not hit_block.is_null
+            and hit_block.block_hash is not None
+        ):
+            self._retain_boundary_block(request_id, hit_block)
+
+    def _prompt_boundary(self, request: Request) -> int:
+        """The prompt position a later turn can resume this request from: the
+        boundary ``reachable_block_mask`` retains and a prefill checkpoint is
+        keyed at."""
+        return get_mamba_prefill_checkpoint_position(
+            request.num_prompt_tokens,
+            self.cache_hit_alignment_tokens,
+            self.drop_eagle_checkpoint_block,
+        )
+
+    def _retain_boundary_block(self, request_id: str, block: KVCacheBlock) -> None:
+        """Hold the request's prompt-boundary state until the request is freed.
+
+        Align mode frees every state below the running one as decode advances
+        and releases a CoW copy once the copy has run, so the one block a later
+        turn can resume from reaches the free queue a step into decode, while
+        the request's attention blocks stay referenced until it finishes. Under
+        allocation pressure the state is recycled first and the next turn's
+        hybrid hit, the minimum over groups, collapses to zero although every
+        attention block of the prompt is still cached. Take a reference on the
+        request's behalf; ``pop_blocks_for_free`` releases it after the
+        request's other blocks.
+        """
+        assert not block.is_null and block.ref_cnt > 0
+        held = self._boundary_blocks.get(request_id)
+        if held is block:
+            return
+        if held is not None:
+            self.block_pool.free_blocks([held])
+        block.ref_cnt += 1
+        self._boundary_blocks[request_id] = block
+
     def _cache_partial_tail_block(
         self,
         request: Request,
@@ -2025,14 +2118,7 @@ def _cache_partial_tail_block(
             # The prompt's final chunk caches only up to its last full block,
             # so ``num_tokens < num_prompt_tokens`` holds there too; its
             # checkpoint is the prompt's reusable boundary, not a transient one.
-            is_prompt_checkpoint = (
-                checkpoint_position
-                == get_mamba_prefill_checkpoint_position(
-                    request.num_prompt_tokens,
-                    self.cache_hit_alignment_tokens,
-                    self.drop_eagle_checkpoint_block,
-                )
-            )
+            is_prompt_checkpoint = checkpoint_position == self._prompt_boundary(request)
             is_retained_checkpoint = False
             if checkpoint_position % self.block_size == 0:
                 block_idx = checkpoint_position // self.block_size - 1
@@ -2056,7 +2142,7 @@ def _cache_partial_tail_block(
                 return None
             if checkpoint_block.block_hash_num_tokens == checkpoint_position:
                 return None
-            return self.block_pool.cache_partial_block(
+            checkpoint_hash = self.block_pool.cache_partial_block(
                 request=request,
                 block=checkpoint_block,
                 num_tokens=checkpoint_position,
@@ -2064,6 +2150,9 @@ def _cache_partial_tail_block(
                 block_size=self.block_size,
                 replace_existing_hashes=True,
             )
+            if checkpoint_hash is not None and is_prompt_checkpoint:
+                self._retain_boundary_block(request.request_id, checkpoint_block)
+            return checkpoint_hash
         if num_tokens <= 0 or num_tokens % hash_block_size != 0:
             return None
         latest_prompt_hash_boundary = get_mamba_prefill_checkpoint_position(
@@ -2098,6 +2187,8 @@ def _cache_partial_tail_block(
             kv_cache_group_id=self.kv_cache_group_id,
             block_size=self.block_size,
         )
+        if partial_hash is not None and num_tokens == self._prompt_boundary(request):
+            self._retain_boundary_block(request.request_id, source_block)
         if partial_hash is not None and num_tokens % self.block_size:
             self._partial_hit_reqs[request.request_id] = (block_idx, source_block)
             self.num_cached_block[request.request_id] = block_idx
