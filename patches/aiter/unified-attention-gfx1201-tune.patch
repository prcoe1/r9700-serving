+      "num_warps": 4,
+      "num_stages": 1,
+      "waves_per_eu": 6,
+      "TILE_SIZE_MIN": 1,
+      "TILE_SIZE_MAX": 32
+    },
     "Q_LEQ_1": {
       "BLOCK_M": 16,
       "num_warps": 4,
