# Active model profile: selects env/${MODEL_PROFILE}.env
MODEL_PROFILE=qwen3.8-27b

# Container runs as this host user so cache dirs stay user-owned.
USER_UID=1000
USER_GID=1000

# Host render group gid for /dev/dri access (check with `getent group render`).
RENDER_GID=992

# Build version pins — ROCm 10.0 per official vLLM-on-ROCm guide.
# Guide: https://rocm.docs.amd.com/en/latest/how-to/vllm-inference-and-serving.html
# - ROCm 10.0, PyTorch 2.12 via https://stable.repo.amd.com/rocm/whl-next/
# - flash-attn 2.8.3 / aiter 0.1.20.post1 via https://rocm.frameworks.amd.com/whl-multi-arch/vllm/
# Source build keeps Python 3.12 (ubuntu 24.04) — 26.04/py3.14 breaks
# amd-quark 0.12.post1 (<3.14) in vLLM requirements/rocm.txt (2026-09-09).
ROCM_IMAGE=docker.io/rocm/dev-ubuntu-24.04:10.0.0-full
GPU_ARCH=gfx1201
MAX_JOBS=16
TORCH_VERSION=2.12.0+rocm10.0.0
TORCHVISION_VERSION=0.27.0+rocm10.0.0
# VLLM_REF and VLLM_VERSION can be a git tag, branch, or commit hash.
VLLM_REF=v0.29.0
VLLM_VERSION=0.29.0
AITER_REF=v0.1.20.post1
# Flash Attention pinned to a specific commit.
FLASH_ATTN_REF=1cc7ff67cbc5685046c75183e8defecca3e35d5c
