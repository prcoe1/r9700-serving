# Model-specific config for Qwen3.6-35B-A3B-FP8 — shares kv_cache_dtype, tool_choice
# via env/qwen3.6.env.common.
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
VLLM_TOKENIZER=Qwen/Qwen3.6-35B-A3B-FP8
VLLM_SERVED_NAME=qwen3.6-35b-a3b
# MoE gated-delta layers force an attention block size of 2112 tokens.
VLLM_MAX_BATCHED_TOKENS=4096
# MTP4 re-enabled (inherited from env/qwen3.6.env.common). vLLM native MTP with
# Qwen3-MoE previously degenerated into token loops (vllm-project/vllm#47087,
# fixed upstream by #51113 in v0.27.1). Re-test on the v0.28.0rc2 build is
# required before trusting this; see benchmarks/2026-08-24_*35b*.
# Re-enable bf16 KV cache: AITER patch reduces TILE_SIZE to fit LDS (was FP8 to work around
# bf16 LDS OOM; original "garbage" output was MTP token loops, not the patch).
VLLM_KV_CACHE_DTYPE=bfloat16
# 0.95 = single-tenant (spends nearly all VRAM on the KV pool). Lower to 0.92 if
# a GPU co-tenant is active (e.g. whisper.cpp Vulkan on GPU0); see compose.yaml.
VLLM_GPU_MEM_UTIL=0.95
# v0.29.0 (#55760 + #55861) defaults prefix_cache_retention_interval to dense
# for hybrid+MTP (see env/qwen3.8-27b.env). Pin dropped; dense is the
# default. Previous pin was 2112 on this gated-delta block-size profile.
# PREFIX_CACHE_RETENTION_INTERVAL=2112

