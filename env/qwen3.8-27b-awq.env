# Trial profile: amd/Qwen3.8-27B-Quark-AWQ-INT4-W4A16 (AWQ INT4 weight-only).
# Requires the backported loader patches/vllm/48606-quark-w4a16.patch
# (upstream PR #48606, open — drop the patch when VLLM_REF contains it).
# Cloned from env/qwen3.8-27b.env with two deliberate differences:
#  - bf16 KV (isolate weight-quant effects; no VLLM_MODEL_ID so
#    ensure-kvscales skips — nothing to calibrate on an AWQ checkpoint).
#  - model/tokenizer point at the HF id directly (ungated, ~19.5 GB).
# Everything else (MTP3, 2048 chunk cap, MRV2, seq-2 cap) is identical so
# bench/probe numbers compare 1:1 against the live FP8 profile.
VLLM_MODEL=amd/Qwen3.8-27B-Quark-AWQ-INT4-W4A16
VLLM_TOKENIZER=amd/Qwen3.8-27B-Quark-AWQ-INT4-W4A16
VLLM_SERVED_NAME=qwen3.8-27b-awq
# 0.95 = single-tenant (spends nearly all VRAM on the KV pool). Lower to 0.92 if
# a GPU co-tenant is active (e.g. whisper.cpp Vulkan on GPU0); see compose.yaml.
VLLM_GPU_MEM_UTIL=0.95
VLLM_MAX_MODEL_LEN=262144
# bf16 KV cache (trial default): higher KV fidelity than fp8 and no
# calibration step. Re-test with fp8 KV only if the bf16 trial passes.
VLLM_KV_CACHE_DTYPE=bfloat16
# 2 concurrent sequences: keep the #35288 cap explicit here (also now the
# universal compose.yaml default). Do not raise until vllm#35288 is fixed.
VLLM_MAX_NUM_SEQS=2
# Same 2026-09-03 chunk-size rationale as the live profile
# (benchmarks/2026-09-03_qwen3.8-27b_concurrent_itl.md): caps the scheduler
# step at one Mamba-block grid stop. Re-run the probe if numbers diverge.
VLLM_MAX_BATCHED_TOKENS=2048
# MTP3 spec-decode, same as the live profile (DFlash2 rejected: see
# archive/DEADENDS.md). Re-tune MTP3 vs MTP4 if acceptance shifts under AWQ.
VLLM_SPEC_DECODE='{"method": "mtp", "num_speculative_tokens": 3, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}'
# v0.29.0 (#55760 + #55861) defaults prefix_cache_retention_interval to dense
# (None) for hybrid GDN + MTP/EAGLE — same as the live profile (unset here).
# PREFIX_CACHE_RETENTION_INTERVAL=1600
# Force V2 model runner (same as the live profile, 2026-09-09): V1 has the
# M-RoPE draft-slot bug #54498 (prompt KV overwrite on image+MTP).
VLLM_USE_V2_MODEL_RUNNER=1
