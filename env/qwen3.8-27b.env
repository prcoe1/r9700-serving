# Model-specific config for Qwen3.8-27B-FP8 — shares spec_decode, tool_choice
# via env/qwen3.6.env.common.
# bf16 KV cache (2026-10-08 operator decision: c2 + bf16, back to the shared
# default after the fp8 era of 09-23→10-08. fp8 was kept for the ~2x KV
# headroom; the 2026-08-22 A/B showed calibrated-fp8 indistinguishable from
# bf16 on PPL/recall. Block size is 832 on bf16 vs 1600 on fp8 — see
# #45238/#55766 geometry notes). The -kvscales model copy is unchanged — its
# calibrated scales are inert under bf16 KV, and `just up`/ensure-kvscales
# stays idempotent (skips once the sidecar exists).
VLLM_MODEL_ID=Qwen/Qwen3.8-27B-FP8
VLLM_MODEL=/home/philip/models-local/Qwen3.8-27B-FP8-kvscales
VLLM_TOKENIZER=/home/philip/models-local/Qwen3.8-27B-FP8-kvscales
VLLM_SERVED_NAME=qwen3.8-27b
# 0.95 = single-tenant (spends nearly all VRAM on the KV pool). Lower to 0.92 if
# a GPU co-tenant is active (e.g. whisper.cpp Vulkan on GPU0); see compose.yaml.
VLLM_GPU_MEM_UTIL=0.95
# 128k max length (2026-09-21: halved from 262144; fp8 KV keeps the pool at
# ~2x bf16 density, so 128k fp8 ≈ 64k bf16 in bytes — headroom to spare vs
# the old 631K-token fp8/262k pool. Raise to 262144 if long-context recall
# needs it; watch #52520 near-ceiling admission behavior). 128k on bf16 is
# the 09-21 probe geometry (block 832, booted + 112k co-prefill clean); the
# pool is half the fp8 one at the same util, so headroom is tighter.
VLLM_MAX_MODEL_LEN=131072
# bf16 KV cache (2026-10-08 operator decision: back to the shared default,
# c2 below). fp8 era: 2026-09-23 restored for the ~2x KV headroom
# (throughput-first, c8 plan), held 09-23→10-08 (incl. the 10-01 c2/MTP3
# state). bf16 vs fp8 trade (09-21, 112k co-prefill, chunk 1024): bf16
# prefill TTFT +8% (70.9 vs 65.9s), co-decode p50 +18% (506 vs 429ms), ~2x
# KV pool pressure (0.42 vs 0.23), identical choke (18.2x vs 18.3x); solo
# decode a hair faster (42.2 vs 43.8ms). block_size 832 at 128k on bf16
# (vs 1600 on fp8).
VLLM_KV_CACHE_DTYPE=bfloat16
# 2 concurrent sequences (2026-10-08: c2 with the bf16 KV switch). The
# uncapped 256 default does not boot on v0.31.0rc3 (exceeds the 249 Mamba
# cache blocks, engine init hard-fails). c2 is the #35288/#55533 mitigation
# for live MTP1 — below both pathologies' thresholds.
VLLM_MAX_NUM_SEQS=2
# 2026-09-03 chunk-size A/B (benchmarks/2026-09-03_qwen3.8-27b_concurrent_itl.md):
# at the 8192 default, a 100K-200K prefill stalls the co-decoder's ITL
# 150-200x (47ms -> p50 3.5-4.4s, p99 up to 9.8s) because each scheduler
# step is one big prefill chunk. 2048 caps the step at one Mamba-block
# (1600tok) grid stop -> ~1.0s ITL during prefill (p99 ~1.5-2s), with flat
# big-prompt TTFT and only -3.4% pp2048 (+27ms).
# 2026-09-21 chunk A/B (benchmarks/2026-09-21_qwen3.8-27b_chunk1024_ab.md),
# c2 with a 112k co-prefill: 1024 halves co-decode stall (B-prefill p50
# 801->429ms, p99 1229->802ms, choke 27.9x->18.3x) for +8% prefill TTFT
# (60.8->65.9s). The 09-03 "below 2048 gains nothing" prediction was wrong
# for ITL smoothness — halving the chunk halves the stall. Keep 1024 while
# concurrent long-context decode smoothness matters more than raw prefill TTFT.
# 2026-10-07 chunk A/B under live MTP1 (benchmarks/2026-10-07_qwen3.8-27b_chunk_mtp1_ab.md),
# 3 victims + 106k co-prefill at cap 4: 2048 buys -17% big-prefill TTFT
# (54.2->44.9s) for ~1.7x co-decode ITL (p50 368->635ms, p99 688->896ms).
# Same tradeoff, sharper under MTP1 — 1024 kept.
VLLM_MAX_BATCHED_TOKENS=1024
# MTP3 spec decode (2026-10-01: re-enabled at K=3 — K was cut 3→1 on 09-26
# for #47602 acceptance decay at depth, then disabled 09-27/09-29; back to 3
# for the decode win. Drafter backend pinned to UA (same as target) per
# #55894. compose.yaml adds --no-async-scheduling automatically (#51571);
# MRV2 covers #54498. (Capped at 4 since 2026-10-05 — the uncapped 256 does
# not boot on rc3, exceeding the 249 Mamba cache blocks; if spec decode is
# re-enabled, drop the pin to 2 for #35288 + #55533.)
# Spec decode: MTP1 LIVE since 2026-10-06 (was off 10-03–10-06; MTP3 before
# that). 4-wide hold verified same day (acceptance 79–93%, max_running=4,
# choke 2.1x — benchmarks/2026-10-06_mtp1_c4_hold.md). Drafter backend pinned
# to UA (same as target) per #55894. compose.yaml adds --no-async-scheduling
# automatically (#51571); MRV2 covers #54498. Keep the pin at 2 if depth ever
# exceeds K=1 at 4-wide (#35288 + #55533 scale with draft slots).
# Single definition only — a second VLLM_SPEC_DECODE line silently wins by
# last-occurrence (cost a wasted restart on 10-06).
VLLM_SPEC_DECODE={"method": "mtp", "num_speculative_tokens": 1, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}
# v0.29.0 (#55760 + #55861) defaults prefix_cache_retention_interval to dense
# (None) for hybrid GDN + MTP/EAGLE (is_hybrid + use_eagle()), covering this
# stack exactly. That is the root-cause fix for vllm#53504 (first repeat missed
# prefix hit), which we previously worked around by pinning the interval to the
# attention block size (1600 on fp8 KV, 832 on bf16). The pin is now dropped —
# compose.yaml only passes --prefix-cache-retention-interval when
# PREFIX_CACHE_RETENTION_INTERVAL is set, so unset means dense. To override
# (e.g. for A/B), set e.g. PREFIX_CACHE_RETENTION_INTERVAL=1600.
# The var is intentionally NOT named VLLM_PREFIX_CACHE_RETENTION_INTERVAL:
# that env var was deprecated in v0.28.1 and removed in v0.29.
# PREFIX_CACHE_RETENTION_INTERVAL=1600
# Force V2 model runner (2026-09-09, ROCm 10.0 / v0.29.0+rocm100 / torch 2.13).
# V1 has M-RoPE draft-slot bug #54498 (prompt KV overwrite on image+MTP);
# V2 fixes it. A/B on this stack: V2 +1.8% pp (3335 vs 3275), tg32 -3.7%
# tg128 +9%, coherence PASSED — keep as default per user request.
VLLM_USE_V2_MODEL_RUNNER=1
