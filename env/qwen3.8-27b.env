# Model-specific config for Qwen3.8-27B-FP8 — shares spec_decode, tool_choice
# via env/qwen3.6.env.common.
# fp8 KV cache (overrides the shared bf16 default). A calibration A/B
# (2026-08-22) showed calibrated-fp8 KV is indistinguishable from scale-1.0 on
# both PPL and long-context recall; fp8 is chosen here to double KV token
# headroom (631K vs ~265K tokens on bf16) at no measured quality/throughput
# cost. Calibrated scales come from the -kvscales copy via `just up`/ensure-kvscales.
VLLM_MODEL_ID=Qwen/Qwen3.8-27B-FP8
VLLM_MODEL=/home/philip/models-local/Qwen3.8-27B-FP8-kvscales
VLLM_TOKENIZER=/home/philip/models-local/Qwen3.8-27B-FP8-kvscales
VLLM_SERVED_NAME=qwen3.8-27b
# 0.92 leaves VRAM headroom for GPU co-tenants (whisper.cpp on GPU0); see compose.yaml.
VLLM_GPU_MEM_UTIL=0.92
VLLM_MAX_MODEL_LEN=262144
# fp8 KV cache: explicit override here (shared env/qwen3.6.env.common defaults
# to bf16). Halves KV memory vs bf16, doubling pool capacity at this util/max-len.
# Revert to bfloat16 if fp8 accuracy is ever questioned (calibrated scales stay safe).
VLLM_KV_CACHE_DTYPE=fp8
# 2 concurrent sequences: keep the #35288 cap explicit here (also now the
# universal compose.yaml default). Do not raise until vllm#35288 is fixed.
VLLM_MAX_NUM_SEQS=2
# 2026-09-03 chunk-size A/B (benchmarks/2026-09-03_qwen3.8-27b_concurrent_itl.md):
# at the 8192 default, a 100K-200K prefill stalls the co-decoder's ITL
# 150-200x (47ms -> p50 3.5-4.4s, p99 up to 9.8s) because each scheduler
# step is one big prefill chunk. 2048 caps the step at one Mamba-block
# (1600tok) grid stop -> ~1.0s ITL during prefill (p99 ~1.5-2s), with flat
# big-prompt TTFT and only -3.4% pp2048 (+27ms). Below 2048 gains nothing
# (step floored at the 1600tok Mamba checkpoint grid). Re-run the probe on
# any vLLM bump or when #45238/#53479 (prefix cache) or #51599 (async
# scheduling) land.
VLLM_MAX_BATCHED_TOKENS=2048
# MTP3 spec-decode. Depth sweep 2026-08-22 (v0.28.0rc2; re-measured on the bf16
# KV default 2026-08-22):
# MTP3 holds decode far better at depth than DFlash2 (tg32 37@d128K vs DFlash
# 15; MTP3 52@d64K vs DFlash 24), though DFlash2 wins at short context (tg32
# ~88 vs MTP3 ~62 @d0). Chosen as default for this repo's deep-context focus.
# DFlash2 rejected: see archive/DEADENDS.md.
VLLM_SPEC_DECODE='{"method": "mtp", "num_speculative_tokens": 3, "attention_backend": "ROCM_AITER_UNIFIED_ATTN"}'
# v0.28.1rc0+#52216 flips prefix_cache_retention_interval default to 0 (sparse,
# semantic checkpoints only), which breaks the first-repeat prefix-cache hit on
# hybrid GDN align with MTP (vllm-project/vllm#53504 — same exact geometry as
# this stack). Restore dense retention by pinning the interval to the attention
# block size (1600 on this fp8-KV profile; 832 on the bf16-KV 27B profile,
# 2112 on 35B-A3B — see their env files).
# Variable is intentionally NOT named VLLM_PREFIX_CACHE_RETENTION_INTERVAL:
# that env var is vLLM-managed (deprecated in v0.28.1, removed in v0.29) and
# env_file would pass it into the container, triggering a deprecation warning
# at every boot. compose.yaml interpolates this name into the
# --prefix-cache-retention-interval CLI flag instead. Re-check before a v0.29
# bump.
PREFIX_CACHE_RETENTION_INTERVAL=1600
# EXPERIMENT (2026-09-03): force the V2 model runner. Not a default arch on
# this platform (ROCm TODO: some models "unsupported by MRV2 or slower");
# motivation is #54498 (V1 M-RoPE draft-slot bug; V2 acceptance higher).
# Test in benchmarks/2026-09-03_qwen3.8-27b_v1_vs_v2.md — remove if the A/B
# doesn't win.
#VLLM_USE_V2_MODEL_RUNNER=1
