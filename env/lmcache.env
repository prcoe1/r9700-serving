# LMCache MP-mode experiment knobs. Loaded LAST in the just lmcache-* recipes,
# so these override the live profile stack for the test engine + sidecar.
#
# Gate 0 — probe N from the LIVE logs before trusting these defaults:
#   just logs 2>&1 | grep -i "Setting attention block size"
# Expect ~832 on bf16/TP2 (the recipe's 784 is the 1-GPU reference; TP changes
# the unified geometry). If live reports a different N, update CHUNK_SIZE and
# MAX_BATCHED_TOKENS below and re-run.
# Upstream default branch is `dev` (there is no `main`). Server and connector
# both build from this one ref, so they are mutually consistent; vLLM-side API
# skew (pin: v0.31.0) is covered by the lmcache-verify gates instead. Pin to a
# tag/commit once a pair validates.
LMCACHE_REF=dev
LMCACHE_CHUNK_SIZE=832
# Prefer 2N-1 (spare N-1 budget lets decodes co-schedule with a prefill block;
# exactly N serializes once any request decodes — upstream recipe finding).
# Must stay inside [N, 2N) for finest per-block snapshots.
LMCACHE_MAX_BATCHED_TOKENS=1663
LMCACHE_L1_SIZE_GB=20
LMCACHE_PORT=5555
# Host 8080 is taken (nextcloud-aio-mastercontainer); 8088 verified free.
LMCACHE_HTTP_PORT=8088
# Chunk hashing depends on a stable hash(); server and engine must agree.
PYTHONHASHSEED=0
