# Model-specific config for Qwen3.6-27B-FP8 — shares kv_cache_dtype, spec_decode, tool_choice
# via env/qwen3.6.env.common.
# bf16 KV cache (inherited from env/qwen3.6.env.common). Calibrated-fp8 copy +
# sidecar stays on disk for opt-in (VLLM_KV_CACHE_DTYPE=fp8).
VLLM_MODEL_ID=Qwen/Qwen3.6-27B-FP8
VLLM_MODEL=/home/philip/models-local/Qwen3.6-27B-FP8-kvscales
VLLM_TOKENIZER=/home/philip/models-local/Qwen3.6-27B-FP8-kvscales
VLLM_SERVED_NAME=qwen3.6-27b
# 0.95 = single-tenant (spends nearly all VRAM on the KV pool). Lower to 0.92 if
# a GPU co-tenant is active (e.g. whisper.cpp Vulkan on GPU0); see compose.yaml.
VLLM_GPU_MEM_UTIL=0.95
# #53504 workaround (v0.28.1rc0+#52216): pin dense Mamba retention to the
# attention block size — 832 on this bf16-KV profile (identical GDN geometry
# to qwen3.8-27b; confirm the "Setting attention block size" line in the boot
# log). Without it, the sparse rc0 default breaks the first-repeat
# prefix-cache hit under MTP. See the full note in env/qwen3.8-27b.env.
PREFIX_CACHE_RETENTION_INTERVAL=832

