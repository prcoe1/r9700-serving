# Common ROCm/GPU environment for vLLM compose services.
# https://rocm.docs.amd.com/en/latest/how-to/rocm-for-ai/inference-optimization/vllm-optimization.html
HIP_VISIBLE_DEVICES=0,1
ROCR_VISIBLE_DEVICES=0,1
HIP_PLATFORM=amd
VLLM_TARGET_DEVICE=rocm
PYTORCH_ROCM_ARCH=gfx1201
HIP_ARCHITECTURES=gfx1201
AMDGPU_TARGETS=gfx1201
GPU_ARCHS=gfx1201
HSA_ENABLE_IPC_MODE_LEGACY=1
HSA_NO_SCRATCH_RECLAIM=1
# Prefer the classic /opt/rocm toolchain over the venv TheRock SDK shims:
# the pip `rocm-sdk-core` hipcc cannot find its device library (10.1 stream
# split device files into rocm-sdk-device-*/devel, and `rocm[devel]` is not
# installed), so every GPU compile fails ("cannot find ROCm device library").
# /opt/rocm/bin/hipcc is the same HIP 7.16 / clang 24 toolchain and compiles
# gfx1201 fine. Without this, aiter's runtime JIT (module_aiter_core) cannot
# build and `import aiter` aborts. Needed since the 2026-10-12 rebuild (fresh
# pip resolve); harmless on images without /opt/rocm (dangling PATH entry).
PATH=/opt/rocm/bin:/opt/venv/bin:/opt/rocm/llvm/bin:/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SAFETENSORS_FAST_GPU=1
PYTORCH_NVML_BASED_CUDA_CHECK=1
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_P2P_DISABLE=1
# RDNA custom all-reduce (vLLM #57767, built into the image) needs
# inter-GPU P2P, which this 2x R9700 board does not expose
# (torch.cuda.can_device_access_peer == False); left disabled, would
# fall back to PYNCCL with a startup warning.
# VLLM_ROCM_USE_RDNA_ALL_REDUCE=1
